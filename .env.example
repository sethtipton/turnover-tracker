VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional: the public application URL embedded in printable maintenance QR
# cards. Include the deployment subpath and trailing slash when applicable.
# VITE_PUBLIC_APP_URL=https://example.com/turnover-tracker/

# OpenAI credentials do not belong in Vite/browser env vars.
# Put the real values in Supabase Edge Function secrets instead:
#   OPENAI_API_KEY
#   OPENAI_MODEL
